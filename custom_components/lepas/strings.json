{
  "config": {
    "step": {
      "login_password": {
        "title": "Sign in with password",
        "description": "Enter your Lepas account email or phone number, password, and vehicle PIN. VIN and account ID are detected automatically. The password is encrypted, used once to sign in and never stored in Home Assistant.{reason}",
        "data": {
          "email": "Email or phone number",
          "area_code": "Country code in digits (e.g. 39)",
          "password": "Account password",
          "pin": "Vehicle control PIN",
          "preset": "Brand / region preset",
          "region_preset": "Brand / region preset",
          "tsp_host": "TSP console host (region)",
          "bff": "BFF endpoint (region)",
          "language": "Language"
        },
        "data_description": {
          "email": "The email address or mobile phone number registered with your Lepas account.",
          "area_code": "Only required if signing in with a phone number (e.g. 39 for Italy, without +). Ignored for email.",
          "password": "Used once to mint the OAuth token, never stored in Home Assistant.",
          "pin": "The 4- or 6-digit PIN used for remote commands.",
          "preset": "Lepas (Europe) and Chery (Europe) fill in everything automatically. Choose Custom to configure another region in the next step.",
          "region_preset": "Lepas (Europe) and Chery (Europe) fill in everything automatically."
        }
      },
      "custom_region": {
        "title": "Custom region / brand",
        "description": "Configure the connection endpoints and technical parameters for your region or brand.{reason}",
        "data": {
          "bff": "BFF endpoint (region)",
          "tenant_code": "Tenant code (advanced)",
          "country_id": "Country ID (advanced)",
          "channel_id": "Channel ID (region)",
          "tsp_host": "TSP console host (region)",
          "car_mqtt_host": "Vehicle MQTT broker host (region)",
          "car_mqtt_port": "Vehicle MQTT broker port (region)",
          "certs_src": "Folder with mutual-TLS certs to import (optional)"
        }
      },
      "select_vehicle": {
        "title": "Select vehicle",
        "description": "Your account has more than one vehicle. Choose the VIN to add.",
        "data": {
          "vin": "Vehicle (VIN)"
        }
      },
      "reconfigure": {
        "title": "Change settings",
        "description": "Update the vehicle control PIN.",
        "menu_options": {
          "reconfigure_pin": "Vehicle control PIN"
        }
      },
      "reconfigure_pin": {
        "title": "Vehicle control PIN",
        "description": "Enter the 4- or 6-digit PIN used for remote commands. The PIN is not used to sign in, so no verification code is needed here. Fix it if commands come back as \"successful\" but the car does nothing.",
        "data": {
          "pin": "Vehicle control PIN"
        }
      },
      "reauth_password": {
        "title": "Re-enter your password",
        "description": "The session expired. Enter the account password for {email} to sign back in — no code needed.{reason}",
        "data": {
          "password": "Account password"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to Lepas servers.",
      "email_invalid": "That email address does not look right.",
      "no_vehicle": "Signed in, but this account has no vehicles. If your car is registered under a different login (e.g. your email address), sign in with that one instead.",
      "password_invalid": "Wrong username or password.",
      "password_required": "Enter your account password.",
      "phone_invalid": "That phone number does not look right. Enter the digits of the number only, without the country code and without spaces; in the other field put only the digits of the country code (Italy = 39).",
      "pin_required": "Enter the vehicle control PIN."
    },
    "abort": {
      "already_configured": "This vehicle (VIN) is already configured.",
      "token_move_failed": "Could not store the authentication token. Check Home Assistant's config folder permissions and try again.",
      "reconfigure_no_entry": "Integration not found — reload Home Assistant and try again.",
      "reconfigure_successful": "PIN updated. The integration was reloaded.",
      "reauth_no_entry": "Integration not found — reload Home Assistant and try again.",
      "reauth_successful": "Re-authentication successful. The integration was reloaded."
    }
  },
  "issues": {
    "pin_wrong": {
      "title": "Lepas: wrong command PIN",
      "fix_flow": {
        "step": {
          "pin": {
            "title": "Fix the vehicle control PIN",
            "description": "Remote commands are being rejected because the 4- or 6-digit control PIN is wrong (the sensors keep working — this is not a login problem). Enter the correct PIN. Do not keep retrying with a wrong PIN, to avoid locking the Chery account.",
            "data": {
              "pin": "Vehicle control PIN"
            }
          }
        },
        "error": {
          "pin_required": "Enter the vehicle control PIN."
        },
        "abort": {
          "entry_not_found": "Integration not found — reload Home Assistant and try again."
        }
      }
    }
  },
