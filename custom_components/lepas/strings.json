  "services": {
    "set_quick_departure": {
      "name": "Set quick departure",
      "description": "Configure and enable or disable a one-time quick departure.",
      "fields": {
        "entry_id": {
          "name": "Vehicle entry",
          "description": "Config entry ID of the vehicle (optional when only one vehicle is configured)."
        },
        "time": {
          "name": "Departure time",
          "description": "Local target departure time (HH:MM)."
        },
        "enabled": {
          "name": "Enabled",
          "description": "Whether the quick departure is enabled."
        },
        "sync_charging": {
          "name": "Sync charging",
          "description": "Adapt charging schedule to finish by the quick departure time."
        },
        "apply_native": {
          "name": "Apply native departure",
          "description": "Force syncing travelAppointControl (and battery preheat if synced) even when native sync is disabled."
        }
      }
    },
    "set_charging_schedule": {
      "name": "Set charging schedule",
      "description": "Configure scheduled charging start time, duration, and active days.",
      "fields": {
        "entry_id": {
          "name": "Vehicle entry",
          "description": "Config entry ID of the vehicle (optional when only one vehicle is configured)."
        },
        "start_time": {
          "name": "Start time",
          "description": "Local charging start time (HH:MM)."
        },
        "duration_hours": {
          "name": "Duration (hours)",
          "description": "Charging duration in hours (1–12)."
        },
        "days": {
          "name": "Days",
          "description": "Preset name, CSV, or list of ISO weekdays (1–7 / mon–sun)."
        },
        "apply": {
          "name": "Apply immediately",
          "description": "Send the updated charging schedule to the vehicle immediately."
        }
      }
    },
    "set_departure_climate_extras": {
      "name": "Set departure climate extras",
      "description": "Configure vehicle-supported comfort extras activated alongside departure pre-climate.",
      "fields": {
        "entry_id": {
          "name": "Vehicle entry",
          "description": "Config entry ID of the vehicle (optional when only one vehicle is configured)."
        },
        "extras": {
          "name": "Climate extras",
          "description": "List of climate extra keys (e.g. steering_wheel_heating, driver_seat_heating, windshield_defog)."
        }
      }
    },
    "set_battery_pack_heat": {
      "name": "Set battery pack heat",
      "description": "Configure battery pack preheating state, local start time, or departure sync.",
      "fields": {
        "entry_id": {
          "name": "Vehicle entry",
          "description": "Config entry ID of the vehicle (optional when only one vehicle is configured)."
        },
        "enabled": {
          "name": "Enabled",
          "description": "Enable or disable battery pack preheating."
        },
        "time": {
          "name": "Start time",
          "description": "Local battery pack preheat start time (HH:MM)."
        },
        "sync_to_departure": {
          "name": "Sync to departure",
          "description": "Automatically align battery preheating to 30 minutes before the next scheduled departure."
        }
      }
    }
  }
}
